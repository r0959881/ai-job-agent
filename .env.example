# ---------------------------------------------------------------------------
# Web app server settings. On cPanel set these under Setup Python App →
# Environment variables instead (see DEPLOYMENT.md). Locally, copy this file
# to .env; without any of them the app runs on http://127.0.0.1:8765 with
# a local SQLite database and the developer sign-in.
# ---------------------------------------------------------------------------

# The address users open. Sign-in redirect URIs are built from it.
PUBLIC_URL=https://jobs.example.com
# Random secret for session cookies and encrypting users' API keys: python manage.py secret-key
SECRET_KEY=
# MySQL on cPanel (URL-encode special characters in the password, e.g. @ -> %40)
DATABASE_URL=mysql+pymysql://cpuser_jobs:password@localhost/cpuser_jobs?charset=utf8mb4

# Sign in with Google (console.cloud.google.com) and/or LinkedIn (linkedin.com/developers)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional: only these addresses or @domains may sign up (comma separated). Empty = everyone.
ALLOWED_EMAILS=
# Optional: seconds one search may spend on job detail pages (keep below the host's request timeout).
SEARCH_TIME_BUDGET=35

# ---------------------------------------------------------------------------
# Command line only (python run_agent.py): single-user keys read from .env.
# Web app users add their own keys in Settings → Integrations instead.
# ---------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
ALERT_EMAIL_FROM=your_email@example.com
ALERT_EMAIL_PASS=your_gmail_app_password_here
ALERT_EMAIL_TO=your_email@example.com
