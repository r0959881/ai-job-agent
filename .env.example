# Copy this file to .env and add your own credentials.
GROQ_API_KEY=your_groq_api_key_here
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Optional email notifications (Gmail app password, not your normal password)
ALERT_EMAIL_FROM=your_email@example.com
ALERT_EMAIL_PASS=your_gmail_app_password_here
ALERT_EMAIL_TO=your_email@example.com

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here